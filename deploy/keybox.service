[Unit]
Description=Key box core
After=network-online.target
Wants=network-online.target
# No listener without the name and time check (kb-join) and the loaded firewall (KBOX-64, KBOX-65).
After=kb-join.service kb-firewall.service
Requires=kb-join.service kb-firewall.service

[Service]
Type=simple
User=keybox
Group=keybox
UMask=0007
Environment=KB_STATE_DIR=/var/lib/keybox KB_SOCKET=/run/keybox/http.sock KB_LEND_SOCKET=/run/keybox-lend/lend.sock
ExecStart=/opt/keybox/current/bin/node /opt/keybox/current/src/main-core.ts
Restart=on-failure
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/keybox /run/keybox /run/keybox-lend

[Install]
WantedBy=multi-user.target
