[Unit]
Description=Key box code (KBOX-20, KBOX-66): a fresh setup or recovery code, with the box address, on the console at every host boot
DefaultDependencies=no
After=local-fs.target kb-join.service
Requires=kb-join.service
Before=keybox.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/keybox/current/bin/node /opt/keybox/current/src/cli/kb-code.ts boot
# The console device is UNVERIFIED on the A1 instance (KBOX-20, design section 12); its path is console_device in
# deploy/runtime.config.json and is probed by the update unit. This is the only unit with device access.
SupplementaryGroups=tty
DeviceAllow=/dev/tty1 w
PrivateDevices=no
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateNetwork=yes
# /etc/keybox/codes (0700) is made by kb-code itself, so the tmpfiles file keeps only the spec directories.
ReadWritePaths=/etc/keybox

[Install]
WantedBy=multi-user.target
