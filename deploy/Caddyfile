# KBOX-44: Caddy serves the box's one Tailscale name (KB_DOMAIN) on two ports and takes each certificate from the local
# tailscaled (get_certificate tailscale; tailscaled grants the caddy user, see tailscaled.defaults). No ACME, no port 80 listener,
# no admin endpoint. Core and the relay are reached over their unix sockets. X-KB-Client-Ip is set from Caddy's own view of the
# connection and replaces any value a client sent; the forwarding headers a client could forge, and those Caddy adds itself, are
# dropped. :8443 is the phone pages (core only); :443 is the machine API (core), /r/* (relay) and 404 otherwise.
# Changes to this file come only through the bootstrap (KBOX-6, KBOX-48). Real header handling on the instance: UNVERIFIED.
{
	auto_https disable_redirects
	admin off
	servers {
		protocols h1 h2
	}
}

{$KB_DOMAIN}:8443 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy unix//run/keybox/http.sock {
		header_up X-KB-Client-Ip {remote_host}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up -Forwarded
		header_up -X-Forwarded-Proto
		header_up -X-Forwarded-Host
	}
}

{$KB_DOMAIN}:443 {
	tls {
		get_certificate tailscale
	}
	header -Set-Cookie
	handle /api/* {
		reverse_proxy unix//run/keybox/http.sock {
			header_up X-KB-Client-Ip {remote_host}
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -Forwarded
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
		}
	}
	handle /r/* {
		reverse_proxy unix//run/keyrelay/http.sock {
			header_up X-KB-Client-Ip {remote_host}
			header_up -X-Forwarded-For
			header_up -X-Real-IP
			header_up -Forwarded
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
		}
	}
	handle {
		respond 404
	}
}
