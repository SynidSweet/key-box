[Unit]
Description=Key box host firewall (KBOX-65): its own nftables table, loaded before the network is up
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/keybox/nftables.nft

[Install]
WantedBy=sysinit.target
