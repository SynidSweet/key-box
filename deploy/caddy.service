[Unit]
Description=Caddy for the key box (KBOX-44): TLS on 443, the client address header, the two unix sockets
After=network-online.target keybox.service keyrelay.service
Wants=network-online.target

[Service]
Type=simple
User=caddy
Group=caddy
ExecStart=/opt/keybox/current/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
StateDirectory=caddy
Restart=on-failure

[Install]
WantedBy=multi-user.target
