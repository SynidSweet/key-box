{
  "default_min": 20,
  "default_alphabet": "[A-Za-z0-9_.~+/=-]",
  "prefixes": [
    { "prefix": "sk-" },
    { "prefix": "sk_" },
    { "prefix": "rk_" },
    { "prefix": "ek_" },
    { "prefix": "vcp_" },
    { "prefix": "vci_" },
    { "prefix": "vca_" },
    { "prefix": "vcr_" },
    { "prefix": "vck_" },
    { "prefix": "sb_secret_" },
    { "prefix": "sbp_" },
    { "prefix": "GOCSPX-", "min": 28, "note": "UNVERIFIED length, checked by the google probe" },
    { "prefix": "AIza", "min": 35, "note": "UNVERIFIED length, checked by the google probe" },
    { "prefix": "ya29." },
    { "prefix": "1//" },
    { "prefix": "github_pat_" },
    { "prefix": "ghp_" },
    { "prefix": "whsec_" }
  ],
  "members": ["private_key", "client_secret", "refresh_token", "access_token", "bearerToken", "signing_secret", "xi-api-key", "api_key"],
  "pem_label_max": 64,
  "jwt_header_max": 512
}
